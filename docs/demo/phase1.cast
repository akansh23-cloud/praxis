{"version": 2, "width": 179, "height": 52, "timestamp": 1787942040, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.101539, "o", "(resetting any previous demo state)\r\n"]
[0.264384, "o", "\r\n\u001b[1m# PRAXIS PHASE 1 — the lifecycle, and what it refuses to do\u001b[0m\r\n"]
[1.274165, "o", "\r\n\u001b[1m# An incident fired. It declares WHERE remediation may act (spec.scope):\u001b[0m\r\n"]
[2.293657, "o", "\u001b[36m$ kubectl apply -f config/samples/praxis_v1alpha1_incident.yaml\u001b[0m\r\n"]
[2.386525, "o", "incident.praxis.dev/checkout-oomkill created\r\n"]
[3.393141, "o", "\r\n\u001b[1m# Evidence gets collected and fingerprinted (hand-set until Phase 3 — status subresource only):\u001b[0m\r\n"]
[4.39506, "o", "\u001b[36m$ kubectl patch incident checkout-oomkill --subresource=status --type=merge -p {\"status\":{\"evidenceBundleHash\":\"sha256:9c1f9c1f9c1f9c1f9c1f9c1f9c1f9c1f9c1f9c1f9c1f9c1f9c1f9c1f9c1f9c1f\"}}\u001b[0m\r\n"]
[4.490064, "o", "incident.praxis.dev/checkout-oomkill patched\r\n"]
[5.497512, "o", "\r\n\u001b[1m# A remediation plan citing exactly that evidence:\u001b[0m\r\n"]
[6.501644, "o", "\u001b[36m$ kubectl apply -f config/samples/praxis_v1alpha1_remediationplan.yaml\u001b[0m\r\n"]
[6.597707, "o", "remediationplan.praxis.dev/checkout-oomkill-7f3a2c created\r\n"]
[7.602977, "o", "\r\n\u001b[1m# The controller walks it Pending → Validating → AwaitingApproval:\u001b[0m\r\n"]
[8.79697, "o", "remediationplan.praxis.dev/checkout-oomkill-7f3a2c condition met\r\n"]
[8.798315, "o", "\u001b[36m$ kubectl get remediationplan checkout-oomkill-7f3a2c\u001b[0m\r\n"]
[8.893965, "o", "NAME                      PHASE              RISK   POLICY   APPROVED-BY   AGE\r\ncheckout-oomkill-7f3a2c   AwaitingApproval                                 2s\r\n"]
[9.898023, "o", "\u001b[36m$ kubectl get remediationplan checkout-oomkill-7f3a2c -o jsonpath={range .status.conditions[*]}{.type}{\"\\t\"}{.status}{\"\\t\"}{.reason}{\"\\n\"}{end}\u001b[0m\r\n"]
[10.004692, "o", "EvidenceValid\tTrue\tEvidenceHashMatches\r\nCitationsResolved\tTrue\tStubbedInPhase1\r\nScopeValid\tTrue\tStubbedInPhase1\r\nApproved\tFalse\tAwaitingApproval\r\n"]
[11.012587, "o", "\r\n\u001b[1m# Approval is bound to a hash of the exact plan + evidence (LLD §8):\u001b[0m\r\n"]
[12.095678, "o", "  boundTo = sha256:9ed455873c38cd845d16f52718bcac1bdcf48ac7c9315007e36d48912c947da5\r\n\r\n\u001b[1m# A human approves by naming that hash — anything else is void:\u001b[0m\r\n"]
[13.099284, "o", "\u001b[36m$ kubectl annotate --overwrite remediationplan checkout-oomkill-7f3a2c praxis.dev/approve=sha256:9ed455873c38cd845d16f52718bcac1bdcf48ac7c9315007e36d48912c947da5 praxis.dev/approved-by=mowar\u001b[0m\r\n"]
[13.197239, "o", "remediationplan.praxis.dev/checkout-oomkill-7f3a2c annotated\r\n"]
[14.200526, "o", "\u001b[36m$ kubectl wait --for=condition=Approved remediationplan/checkout-oomkill-7f3a2c --timeout=60s\u001b[0m\r\n"]
[14.389306, "o", "remediationplan.praxis.dev/checkout-oomkill-7f3a2c condition met\r\n"]
[15.394807, "o", "\u001b[36m$ kubectl get remediationplan checkout-oomkill-7f3a2c\u001b[0m\r\n"]
[15.491945, "o", "NAME                      PHASE              RISK   POLICY   APPROVED-BY   AGE\r\ncheckout-oomkill-7f3a2c   AwaitingApproval                   mowar         9s\r\n"]
[16.496729, "o", "\r\n\u001b[1m# STRUCTURAL REJECTION 1 — an approved plan cannot be edited into a different plan:\u001b[0m\r\n"]
[17.498523, "o", "\u001b[36m$ kubectl patch remediationplan checkout-oomkill-7f3a2c --type=merge -p {\"spec\":{\"evidenceBundleHash\":\"sha256:abababababababababababababababababababababababababababababababab\"}}\u001b[0m\r\n"]
[17.576153, "o", "The RemediationPlan \"checkout-oomkill-7f3a2c\" is invalid: spec: Invalid value: RemediationPlan spec is immutable; create a new plan instead of editing\r\n"]
[17.577435, "o", "\u001b[32m^ refused, as designed\u001b[0m\r\n"]
[18.578912, "o", "\r\n\u001b[1m# STRUCTURAL REJECTION 2 — a verb outside the closed vocabulary cannot exist:\u001b[0m\r\n"]
[19.583124, "o", "\u001b[36m$ kubectl apply -f docs/demo/delete-namespace-plan.yaml\u001b[0m\r\n"]
[19.67347, "o", "The RemediationPlan \"demo-forbidden-plan\" is invalid: \r\n* spec.actions[0].type: Unsupported value: \"DeleteNamespace\": supported values: \"RestartWorkload\", \"ScaleWorkload\", \"RollbackRelease\", \"PatchResourceLimits\", \"CordonNode\"\r\n* <nil>: Invalid value: null: some validation rules were not checked because the object was invalid; correct the existing errors to complete validation\r\n"]
[19.67484, "o", "\u001b[32m^ refused, as designed\u001b[0m\r\n"]
[20.678624, "o", "\r\n\u001b[1m# ...and nothing was persisted:\u001b[0m\r\n"]
[21.694068, "o", "\u001b[36m$ kubectl get remediationplan demo-forbidden-plan\u001b[0m\r\n"]
[21.924468, "o", "Error from server (NotFound): remediationplans.praxis.dev \"demo-forbidden-plan\" not found\r\n"]
[21.926921, "o", "\u001b[32m^ refused, as designed\u001b[0m\r\n"]
[22.930805, "o", "\r\n\u001b[1m# Phase 1, end to end: validated lifecycle, hash-bound approval, and an API surface that refuses what it should.\u001b[0m\r\n"]
